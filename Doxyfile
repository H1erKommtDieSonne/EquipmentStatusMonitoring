PROJECT_NAME           = "EquipmentStatusMonitoring"
PROJECT_BRIEF          = "Иерархия устройств"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = Russian
INPUT                  = Device.h Device.cpp DeviceCollection.h FaultyDevice.h faultyDevice.cpp FaultyDeviceEx.h FaultyDeviceEx.cpp HealthyDevice.h HealthyDevice.cpp ReserveDevice.h ReserveDevice.cpp ServicePriority.h main.cpp esm bindings storage python docs/pages README.md
